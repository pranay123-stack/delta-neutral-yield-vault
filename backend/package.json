{
  "name": "@dnv/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Indexer, snapshotter, alert engine, keeper, market driver and REST API for the delta-neutral vault.",
  "scripts": {
    "start": "tsx src/index.ts all",
    "api": "tsx src/index.ts api",
    "keeper": "tsx src/index.ts keeper",
    "indexer": "tsx src/index.ts indexer",
    "migrate": "tsx src/index.ts migrate",
    "history": "tsx src/index.ts history",
    "demo": "tsx src/demo.ts",
    "openapi": "tsx src/api/exportOpenapi.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnv/shared": "workspace:*",
    "@dnv/simulator": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "fastify": "5.12.4",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "viem": "2.56.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
