# Copy to .env to override defaults. Everything targets a LOCAL Anvil with mock markets.
# The private keys below are Anvil's published dev keys: they control nothing outside a local chain.

# --- chain ---
RPC_URL=http://127.0.0.1:8555
CHAIN_ID=31337
# DEPLOYMENT_FILE=deployments/31337.json

# --- backend ---
DATABASE_URL=postgres://dnv:dnv@127.0.0.1:5476/dnv
API_PORT=4010
CORS_ORIGIN=*
KEEPER_ENABLED=true
KEEPER_INTERVAL_MS=15000
INDEXER_INTERVAL_MS=5000
SNAPSHOT_INTERVAL_MS=15000
KEEPER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
SIMULATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
GUARDIAN_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
LOG_LEVEL=info

# --- history replay (docker compose / `pnpm --filter @dnv/backend history`) ---
HISTORY_DAYS=90
HISTORY_SEED=20260911

# --- frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4010
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8555

# --- docker compose host ports ---
POSTGRES_PORT=5476
ANVIL_PORT=8555
FRONTEND_PORT=3010

# --- Sepolia (optional; never commit a real key) ---
# DEPLOYER_PRIVATE_KEY=
# ADMIN_ADDRESS=      # should be a TimelockController / multisig
# GUARDIAN_ADDRESS=
# KEEPER_ADDRESS=
# STRATEGIST_ADDRESS=
# FEE_RECIPIENT_ADDRESS=
